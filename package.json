{
  "name": "code-root",
  "displayName": "Code Root",
  "description": "Browse every project under one root folder and open it in this window or a new one",
  "version": "0.2.0",
  "publisher": "ProdigyCorp",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sami999khan999/code_root.git"
  },
  "bugs": {
    "url": "https://github.com/sami999khan999/code_root/issues"
  },
  "homepage": "https://github.com/sami999khan999/code_root#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "projects",
    "project manager",
    "folders",
    "recent",
    "workspace",
    "open folder"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce package"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeRoot",
          "title": "Code Root",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "codeRoot": [
        {
          "id": "codeRoot.tree",
          "name": "Projects",
          "icon": "media/activity.svg",
          "contextualTitle": "Code Root"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeRoot.tree",
        "contents": "Keep every project one click away.\nPick the folder where all your code lives. Its folders and projects will show up here.\n[$(folder-opened) Select Root Folder](command:codeRoot.selectRoot)\nYou can change it later from the ··· menu above.",
        "when": "codeRoot.state == noRoot"
      },
      {
        "view": "codeRoot.tree",
        "contents": "The root folder can't be found. It may have been moved, renamed, or be on a drive that isn't mounted.\n[$(folder-opened) Choose Another Folder](command:codeRoot.selectRoot)\n[$(refresh) Try Again](command:codeRoot.refresh)",
        "when": "codeRoot.state == missing"
      }
    ],
    "commands": [
      {
        "command": "codeRoot.selectRoot",
        "title": "Select Root Folder…",
        "category": "Code Root",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codeRoot.find",
        "title": "Find Project…",
        "category": "Code Root",
        "icon": "$(search)"
      },
      {
        "command": "codeRoot.refresh",
        "title": "Refresh",
        "category": "Code Root",
        "icon": "$(refresh)"
      },
      {
        "command": "codeRoot.open",
        "title": "Open Here",
        "category": "Code Root",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codeRoot.openNewWindow",
        "title": "Open in New Window",
        "category": "Code Root",
        "icon": "$(empty-window)"
      },
      {
        "command": "codeRoot.revealInOS",
        "title": "Reveal in File Manager",
        "category": "Code Root"
      },
      {
        "command": "codeRoot.copyPath",
        "title": "Copy Path",
        "category": "Code Root"
      },
      {
        "command": "codeRoot.removeFromRecent",
        "title": "Remove from Recent",
        "category": "Code Root"
      },
      {
        "command": "codeRoot.clearRecent",
        "title": "Clear Recent",
        "category": "Code Root",
        "icon": "$(clear-all)"
      },
      {
        "command": "codeRoot.keyboardShortcuts",
        "title": "Keyboard Shortcuts",
        "category": "Code Root",
        "icon": "$(keyboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeRoot.find",
          "when": "view == codeRoot.tree && codeRoot.state == ready",
          "group": "navigation@1"
        },
        {
          "command": "codeRoot.refresh",
          "when": "view == codeRoot.tree && codeRoot.state == ready",
          "group": "navigation@2"
        },
        {
          "command": "codeRoot.selectRoot",
          "when": "view == codeRoot.tree",
          "group": "1_root"
        },
        {
          "command": "codeRoot.clearRecent",
          "when": "view == codeRoot.tree && codeRoot.state == ready",
          "group": "2_recent"
        },
        {
          "command": "codeRoot.keyboardShortcuts",
          "when": "view == codeRoot.tree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "codeRoot.open",
          "when": "view == codeRoot.tree && viewItem =~ /^(project|folder)/",
          "group": "inline@1"
        },
        {
          "command": "codeRoot.openNewWindow",
          "when": "view == codeRoot.tree && viewItem =~ /^(project|folder)/",
          "group": "inline@2"
        },
        {
          "command": "codeRoot.clearRecent",
          "when": "view == codeRoot.tree && viewItem == recentGroup",
          "group": "inline"
        },
        {
          "command": "codeRoot.open",
          "when": "view == codeRoot.tree && viewItem =~ /^(project|folder)/",
          "group": "1_open@1"
        },
        {
          "command": "codeRoot.openNewWindow",
          "when": "view == codeRoot.tree && viewItem =~ /^(project|folder)/",
          "group": "1_open@2"
        },
        {
          "command": "codeRoot.revealInOS",
          "when": "view == codeRoot.tree && viewItem =~ /^(project|folder)/",
          "group": "2_path@1"
        },
        {
          "command": "codeRoot.copyPath",
          "when": "view == codeRoot.tree && viewItem =~ /^(project|folder)/",
          "group": "2_path@2"
        },
        {
          "command": "codeRoot.removeFromRecent",
          "when": "view == codeRoot.tree && viewItem =~ /\\.recent$/",
          "group": "3_recent"
        }
      ],
      "commandPalette": [
        { "command": "codeRoot.open", "when": "false" },
        { "command": "codeRoot.openNewWindow", "when": "false" },
        { "command": "codeRoot.revealInOS", "when": "false" },
        { "command": "codeRoot.copyPath", "when": "false" },
        { "command": "codeRoot.removeFromRecent", "when": "false" }
      ]
    },
    "keybindings": [
      {
        "command": "codeRoot.find",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "codeRoot.tree.focus",
        "key": "ctrl+shift+alt+o",
        "mac": "cmd+shift+alt+o"
      },
      {
        "command": "codeRoot.open",
        "key": "enter",
        "mac": "enter",
        "when": "focusedView == codeRoot.tree && listFocus && !inputFocus && codeRoot.selection =~ /^(project|folder)/ || inQuickOpen && codeRoot.finding"
      },
      {
        "command": "codeRoot.openNewWindow",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "focusedView == codeRoot.tree && listFocus && !inputFocus && codeRoot.selection =~ /^(project|folder)/ || inQuickOpen && codeRoot.finding"
      },
      {
        "command": "codeRoot.revealInOS",
        "key": "shift+alt+r",
        "mac": "alt+cmd+r",
        "when": "focusedView == codeRoot.tree && listFocus && !inputFocus && codeRoot.selection =~ /^(project|folder|rootGroup)/"
      },
      {
        "command": "codeRoot.copyPath",
        "key": "shift+alt+c",
        "mac": "alt+cmd+c",
        "when": "focusedView == codeRoot.tree && listFocus && !inputFocus && codeRoot.selection =~ /^(project|folder|rootGroup)/"
      },
      {
        "command": "codeRoot.removeFromRecent",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == codeRoot.tree && listFocus && !inputFocus && codeRoot.selection =~ /\\.recent$/"
      },
      {
        "command": "codeRoot.clearRecent",
        "key": "ctrl+shift+delete",
        "mac": "cmd+shift+backspace",
        "when": "focusedView == codeRoot.tree && listFocus && !inputFocus"
      },
      {
        "command": "codeRoot.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "focusedView == codeRoot.tree && listFocus && !inputFocus"
      },
      {
        "command": "codeRoot.selectRoot",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "focusedView == codeRoot.tree && listFocus && !inputFocus"
      },
      {
        "command": "codeRoot.keyboardShortcuts",
        "key": "ctrl+k ctrl+alt+o",
        "mac": "cmd+k cmd+alt+o"
      }
    ],
    "configuration": {
      "title": "Code Root",
      "properties": {
        "codeRoot.rootFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The folder where all your code lives. `~` means your home folder. Per machine, so Settings Sync won't copy a Linux path to Windows."
        },
        "codeRoot.recentCount": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 30,
          "description": "How many recently opened projects to show at the top. 0 hides the Recent group."
        },
        "codeRoot.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules", "__pycache__", "venv", ".venv", "dist", "build", "out", "target", "vendor", "coverage"],
          "description": "Folder names that are never listed."
        },
        "codeRoot.showHidden": {
          "type": "boolean",
          "default": false,
          "description": "List folders whose name starts with a dot."
        },
        "codeRoot.searchDepth": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "How many folder levels deep Find Project looks for projects."
        }
      }
    }
  }
}
